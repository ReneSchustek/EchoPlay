<?xml version="1.0" encoding="utf-8"?>
<!-- Wiederverwendbare Serien-Kachel (140×140) mit Cover, Text-Overlay und optionalen Buttons.
     Wird in lokaler und Online-Mediathek identisch verwendet – DRY statt duplizierter DataTemplates.
     Optionales V-Icon unter der Kachel zeigt die aktive Serie im Akkordeon.

     Kachelform der Gestaltungslinie: kleiner Eckenradius, Haarlinie als Rand, kein
     Schlagschatten. Beim Überfahren wechselt der Rand die Farbe — die Kachel hebt sich
     nicht an.

     Das Cover bleibt die Fläche der Kachel und wird nicht durch einen farbigen Kopf
     ersetzt: Bei einer Hörspiel-Sammlung ist das Cover der Inhalt, nicht die Dekoration.
     Die Leitform mit farbigem Kopf tragen die Kennzahl-Kacheln des Dashboards. -->
<UserControl
    x:Class="EchoPlay.App.Controls.SeriesTileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="TileFrame.BorderBrush" Value="{ThemeResource AccentPrimaryBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="TileFrame"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource HairlineBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}"
            Margin="4"
            PointerEntered="OnTilePointerEntered"
            PointerExited="OnTilePointerExited">
        <Grid Width="140" Height="140" CornerRadius="{StaticResource CardCornerRadius}">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,140,140"/>
            </Grid.Clip>

            <!-- Cover-Bild -->
            <Image
                x:Name="CoverImageElement"
                Stretch="UniformToFill"/>

            <!-- Platzhalter wenn kein Cover -->
            <Border
                x:Name="PlaceholderBorder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE8D6;"
                    FontSize="{StaticResource TileHeaderIconSize}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Text-Overlay unten -->
            <Border
                VerticalAlignment="Bottom"
                Background="{StaticResource MediaScrimStrongBrush}"
                CornerRadius="0,0,4,4"
                Padding="6,4">
                <StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        Foreground="{StaticResource TextOnMediaBrush}"
                        FontSize="12"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{StaticResource TextOnMediaMutedBrush}"
                        FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- Favoriten-Button oben links -->
            <!-- Der Name kommt aus der Ressourcendatei: Der Knopf trägt nur einen Stern,
                 und ohne Namen liest eine Sprachausgabe an dieser Stelle nichts vor. -->
            <!-- Die drei Zeichen auf dem Cover bleiben bewusst bei 28 Punkten und damit
                 unter der Untergrenze für ein Bedienziel: Drei Schaltflächen zu 40 Punkten
                 nähmen auf einer 148 Punkte breiten Kachel fast die ganze Breite ein und
                 verdeckten das Cover, das hier der eigentliche Inhalt ist. Jede der drei
                 Aktionen ist zusätzlich über das Kontextmenü der Kachel erreichbar — das
                 ist der zweite Weg, den die Vorgabe für kleine Ziele verlangt. -->
            <Button
                x:Name="FavoriteButton"
                x:Uid="SeriesTileFavoriteButton"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Width="28" Height="28" Padding="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="4,4,0,0" CornerRadius="{StaticResource ControlCornerRadius}"
                Background="{StaticResource MediaScrimSoftBrush}" Foreground="{StaticResource FavoriteMarkerBrush}"
                FontSize="14"
                Visibility="Collapsed"/>

            <!-- Überwachungs-Icon oben links unterhalb des Favoriten-Sterns -->
            <Button
                x:Name="WatchedIndicator"
                x:Uid="SeriesTileWatchedIndicator"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Width="28" Height="28" Padding="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="4,36,0,0" CornerRadius="{StaticResource ControlCornerRadius}"
                Background="{StaticResource MediaScrimSoftBrush}" Foreground="{StaticResource TextOnMediaBrush}"
                FontSize="14"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

            <!-- Kontextmenü-Button oben rechts -->
            <Button
                    x:Uid="SeriesTileContextMenuButton"
                x:Name="ContextMenuButton"
                Content="&#xE712;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Width="28" Height="28" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,4,4,0" CornerRadius="{StaticResource ControlCornerRadius}"
                Background="{StaticResource MediaScrimSoftBrush}" Foreground="{StaticResource TextOnMediaBrush}"/>
        </Grid>
        </Border>

        <!-- V-Pfeil unter der Kachel – zeigt an welche Serie im Akkordeon aufgeklappt ist -->
        <FontIcon
            x:Name="SelectedIndicator"
            Glyph="&#xE70D;"
            FontSize="12"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
