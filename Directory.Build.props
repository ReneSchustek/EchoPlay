<Project>
  <!--
    Zentrale Build-Konfiguration für alle Projekte in dieser Solution.
    Einzelne .csproj-Dateien können diese Werte überschreiben.
  -->
  <PropertyGroup>
    <!-- SemVer-2.0.0-Versionsquelle für die gesamte Solution. Treibt AssemblyVersion/
         FileVersion/InformationalVersion aller Projekte. UpdateCheckService liest genau
         diese Version (Assembly.GetName().Version) und vergleicht sie gegen den neuesten
         GitHub-Release-Tag (vX.Y.Z). Bei jedem Release hier UND in
         src/EchoPlay.App/Package.appxmanifest (Version="X.Y.Z.0") synchron hochzählen. -->
    <VersionPrefix>1.5.3</VersionPrefix>
    <!-- Fester Stand der Windows-Projektion. Ohne Angabe nimmt jedes SDK seine eigene mit
         (10.0.403 bringt .57, 10.0.404 bringt .87), und mit .87 kam eine neue Prüfung des
         WinRT-Generators hinzu. Der lokale Bau war dadurch grün, während das Fließband mit
         demselben Code rot war. Beim Anheben beide Seiten gemeinsam bauen. -->
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
    <!-- Nullability: Null-Reference-Warnungen als Fehler -->
    <Nullable>enable</Nullable>
    <!-- Moderne using-Direktiven automatisch -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Alle Warnungen sind Fehler -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Alle Analyzer-Regeln aktiv (Zero-Warnings-Regel) -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Code-Style in Build erzwingen -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML-Dokumentation generieren (für IntelliSense) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Test-Projekte: xUnit-Konventionen (Unterstriche in Testnamen) -->
  <!-- Die Dokumentationsdatei bleibt an, weil der Build ungenutzte using-Direktiven (IDE0005)
       nur dann meldet. Fehlende XML-Kommentare (CS1591) sind in Tests kein Befund: Testmethoden
       erklären sich über ihren Namen. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or '$(MSBuildProjectName)' == 'EchoPlay.Fuzz'">
    <NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Build-Härtung: Reproduzierbarkeit und CI-Stempel.
       Deterministic stellt sicher, dass identischer Source identische Bytes erzeugt;
       ContinuousIntegrationBuild blendet maschinenspezifische Pfade aus PDBs aus. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Statische Sicherheits-Analyse für Produktiv-Code (nicht für Tests).
       SecurityCodeScan ergänzt die NetAnalyzer-Default-Regeln um Patterns wie
       weak Random, Path-Traversal, ungeprüfte Deserialisierung. -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="SecurityCodeScan.VS2019">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
