<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EchoPlay.App.Views.LocalLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EchoPlay.App.ViewModels"
    xmlns:ctrl="using:EchoPlay.App.Controls"
    xmlns:helpers="using:EchoPlay.App.Helpers">

    <Page.Resources>
        <!-- Gemeinsamer ItemTemplate für Top- und Bottom-Grid der lokalen Mediathek.
             Vermeidet Duplikation des Kontextmenüs und stellt sicher, dass die
             Indikatoren (Favorit, Watched, Auswahl) in beiden Grids konsistent angezeigt werden. -->
        <DataTemplate x:Key="LokalSeriesTileTemplate" x:DataType="vm:LocalArtistCardViewModel">
            <ctrl:SeriesTileControl
                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                CoverImage="{x:Bind CoverImage, Mode=OneWay}"
                Title="{x:Bind Title, Mode=OneTime}"
                Subtitle="{x:Bind CountText, Mode=OneTime}"
                FavoriteVisibility="Visible"
                FavoriteGlyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                FavoriteCommand="{x:Bind ToggleFavoriteCommand}"
                WatchedVisibility="{x:Bind WatchedVisibility, Mode=OneWay}"
                WatchedGlyph="{x:Bind WatchedGlyph, Mode=OneTime}"
                SelectedIndicatorVisibility="{x:Bind SelectedIndicatorVisibility, Mode=OneWay}">
                <ctrl:SeriesTileControl.ContextFlyoutMenu>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="SeriesDetailsItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnSeriesDetailsClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Uid="WatchSeriesItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            IsChecked="{x:Bind IsWatched, Mode=OneWay}"
                            Click="OnToggleWatchSeriesClick">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;"/>
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            x:Uid="LokalMarkAllAsReadItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnMarkAllAsReadClick"/>
                        <MenuFlyoutItem
                            x:Uid="LokalMissingEpisodesItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnShowMissingEpisodesClick"/>
                        <MenuFlyoutItem
                            x:Uid="LokalRemoveFromLibraryItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnRemoveSeriesFromLibraryClick"/>
                        <MenuFlyoutItem
                            x:Uid="LokalDeleteFromDiskItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnDeleteSeriesFromDiskClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            x:Uid="LokalSeriesCoverSelectItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnSeriesCoverSelectClick"/>
                        <MenuFlyoutItem
                            x:Uid="LokalSeriesCoverSearchItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnSeriesCoverSearchClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem
                            x:Uid="LokalRestructureItem"
                            Tag="{x:Bind SeriesId, Mode=OneTime}"
                            Click="OnRestructureClick"/>
                    </MenuFlyout>
                </ctrl:SeriesTileControl.ContextFlyoutMenu>
            </ctrl:SeriesTileControl>
        </DataTemplate>

        <!-- Ein Buchstaben-Abschnitt: Überschrift und die Kacheln darunter.
             Die Vorlage steht hier und nicht in einem eigenen Control, weil das Kachel-Menü
             oben an Handler dieser Seite gebunden ist – die greifen nur im selben Dokument. -->
        <DataTemplate x:Key="LokalLetterSectionTemplate" x:DataType="helpers:LetterSection">
            <StackPanel AutomationProperties.Name="{x:Bind AutomationName}">
                <TextBlock
                    Text="{x:Bind Header}"
                    Visibility="{x:Bind HeaderVisibility}"
                    Style="{StaticResource SectionHeaderTextStyle}"
                    Margin="4,8,4,4"/>
                <GridView
                    ItemsSource="{x:Bind Items}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnArtistItemClick"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemTemplate="{StaticResource LokalSeriesTileTemplate}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="148" ItemHeight="166"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Aufbau der Gestaltungslinie, von oben: Seitenkopf, Suchfeld, Filterleiste,
             Buchstabenleiste, dann die Liste. Die beiden Hinweisleisten stehen darüber,
             weil sie den Zustand der Seite betreffen und nicht ihren Inhalt. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hilfe -->
        <ctrl:HelpButtonControl TipUid="HelpTipLokal"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,16,0" Canvas.ZIndex="1"/>

        <!-- Scan-Hinweis: erscheint während ein Scan oder eine Neu-Initialisierung läuft.
             Kurze, neutrale Meldung oben – Details stehen in der Statusleiste unten. -->
        <InfoBar
            Grid.Row="0"
            x:Uid="LokalScanningHint"
            IsOpen="{x:Bind ViewModel.ScanVM.IsScanning, Mode=OneWay}"
            IsClosable="False"
            Severity="Informational"
            Margin="8,8,8,0"/>

        <!-- Hinweis: wird nur angezeigt, wenn noch kein Bibliotheksordner konfiguriert ist -->
        <InfoBar
            Grid.Row="1"
            x:Uid="LokalNoFolderHint"
            IsOpen="{x:Bind ViewModel.ScanVM.NeedsLibraryFolderSetup, Mode=OneWay}"
            IsClosable="False"
            Severity="Informational"
            Margin="8,4,8,0">
            <InfoBar.ActionButton>
                <Button x:Uid="LokalPickFolderButton" Click="OnPickFolderClick"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Seitenkopf: Titel, Zweck der Seite, rechts die Primäraktion -->
        <ctrl:PageHeaderControl
            x:Name="LokalHeader"
            Grid.Row="2"
            Margin="16,12,16,0"
            ActionCommand="{x:Bind ViewModel.ScanVM.ScanCommand}"/>

        <!-- Bibliothekspfad, Suche und Scan-Aktionen -->
        <Grid Grid.Row="3" Padding="16,8,16,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Suchfeld: filtert die Serien-Kacheln beim Tippen, ohne Schaltfläche daneben -->
            <ctrl:SearchBoxControl
                x:Name="LokalSearchField"
                Grid.Column="0"
                Width="250"
                VerticalAlignment="Center"
                SearchText="{x:Bind ViewModel.ArtistsVM.LocalSearchText, Mode=TwoWay}"/>

            <!-- Pfadanzeige: zeigt den konfigurierten Wurzelpfad der lokalen Bibliothek -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="LokalLibraryPathLabel"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    Text="{x:Bind ViewModel.ScanVM.LibraryRootPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ScanVM.LibraryRootPath, Mode=OneWay}"/>
            </StackPanel>

            <!-- Neu-Initialisierung: löscht alle Zuordnungen und baut sie komplett neu auf -->
            <Button
                Grid.Column="2"
                x:Uid="MediathekLokalResetButton"
                Command="{x:Bind ViewModel.ScanVM.ReInitializeCommand}"
                IsEnabled="{x:Bind ViewModel.ScanVM.IsNotScanning, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE777;" FontSize="{StaticResource IconSizeM}"/>
            </Button>

            <!-- Manuell: Ordner direkt als lokale Serie anlegen, ohne vollständigen Scan -->
            <Button
                Grid.Column="3"
                x:Uid="MediathekLokalAddFolderButton"
                Click="OnAddFolderClick"
                IsEnabled="{x:Bind ViewModel.ScanVM.IsNotScanning, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE8F4;" FontSize="{StaticResource IconSizeM}"/>
            </Button>

            <!-- Alle Serien auf fehlende Folgen prüfen (lokal + online) -->
            <Button
                Grid.Column="4"
                x:Uid="LokalCheckAllSeriesButton"
                Command="{x:Bind ViewModel.CheckAllSeriesCommand}"
                IsEnabled="{x:Bind ViewModel.ScanVM.IsNotScanning, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                <FontIcon Glyph="&#xE762;" FontSize="{StaticResource IconSizeM}"/>
            </Button>
        </Grid>

        <!-- Filterleiste: Chips zum Umschalten. Mehrere Filter wirken zusammen. -->
        <ctrl:FilterBarControl
            x:Name="LokalFilterBar"
            Grid.Row="4"
            Margin="16,0,16,4"
            FilterToggled="OnFilterToggled"/>

        <!-- Fortschrittsbalken: deterministisch wenn Serien- oder Dateianzahl bekannt,
             sonst indeterministisch. Sichtbar nur während eines aktiven Scans. -->
        <ProgressBar
            Grid.Row="5"
            IsIndeterminate="{x:Bind ViewModel.ScanVM.IsScanIndeterminate, Mode=OneWay}"
            Value="{x:Bind ViewModel.ScanVM.ScanProgressPercent, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ScanVM.IsScanningVisibility, Mode=OneWay}"
            Margin="8,0,8,4"/>

        <!-- Buchstabenleiste: springt zum Abschnitt, filtert nicht. Sie steht über der
             Liste und scrollt nicht mit – ein Anlaufpunkt, der wegscrollt, ist keiner. -->
        <ctrl:AlphabetBarControl
            x:Name="SeriesAlphabetBar"
            Grid.Row="6"
            Margin="16,0,16,4"
            LetterSelected="OnLetterSelected"/>

        <!-- Akkordeon-Inhalt – Serien-Abschnitte aufgeteilt um das Folgen-Panel -->
        <!-- Episoden-Header: fixiert außerhalb des ScrollViewers, scrollt nicht mit -->
        <StackPanel Grid.Row="7" Padding="16,4,16,4"
                    Visibility="{x:Bind ViewModel.ArtistsVM.EpisodesAccordionVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Uid="LokalEpisodesHeader"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Button x:Uid="LokalCloseEpisodesButton"
                            Click="OnCloseEpisodePanelClick"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="120"
                          SelectedIndex="{x:Bind ViewModel.EpisodesVM.EpisodeFilterIndex, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.EpisodesVM.EpisodesLoadedVisibility, Mode=OneWay}">
                    <ComboBoxItem x:Uid="LokalFilterAll"/>
                    <ComboBoxItem x:Uid="LokalFilterUnheard"/>
                    <ComboBoxItem x:Uid="LokalFilterHeard"/>
                    <ComboBoxItem x:Uid="LokalFilterInProgress"/>
                </ComboBox>
                <ComboBox Grid.Column="2" MinWidth="140"
                          SelectedIndex="{x:Bind ViewModel.EpisodesVM.EpisodeSortIndex, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.EpisodesVM.EpisodesLoadedVisibility, Mode=OneWay}">
                    <ComboBoxItem x:Uid="LokalSortByNumber"/>
                    <ComboBoxItem x:Uid="LokalSortByNumberDesc"/>
                    <ComboBoxItem x:Uid="LokalSortByTitle"/>
                </ComboBox>
                <Button Grid.Column="3"
                        x:Uid="MediathekLokalSeriesTagManagerButton"
                        Command="{x:Bind ViewModel.TracksVM.OpenAllSeriesTracksCommand}"
                        Visibility="{x:Bind ViewModel.ArtistsVM.SeriesActionsVisibility, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                    <FontIcon Glyph="&#xE8EC;" FontSize="{StaticResource IconSizeS}"/>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="0,0"
                        Visibility="{x:Bind ViewModel.EpisodesVM.HasSpecialEpisodes, Mode=OneWay}">
                <RadioButton x:Uid="LokalTabEpisodes" GroupName="EpisodeTab"
                             IsChecked="True" Checked="OnEpisodeTabRegularChecked"/>
                <RadioButton GroupName="EpisodeTab" Checked="OnEpisodeTabSpecialChecked">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Uid="LokalTabSpecial"/>
                        <TextBlock Text="("/>
                        <TextBlock Text="{x:Bind ViewModel.EpisodesVM.SpecialEpisodeCount, Mode=OneWay}"/>
                        <TextBlock Text=")"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <TextBlock x:Uid="LokalEpisodesEmpty"
                       Visibility="{x:Bind ViewModel.EpisodesVM.EpisodesEmptyVisibility, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="16,16,16,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Zuklappen, ohne zurückzuscrollen: Der Folgenbereich kann weit unten aufgehen,
             und der Weg zum Schließen-Zeichen im Kopf wäre dann eine halbe Bildschirmhöhe.
             Der Knopf schwebt über der Liste und bleibt beim Scrollen stehen. -->
        <Button
            x:Name="CollapseEpisodesButton"
            x:Uid="LokalCollapseEpisodesFloatingButton"
            Grid.Row="8"
            Click="OnCloseEpisodePanelClick"
            Visibility="{x:Bind ViewModel.ArtistsVM.EpisodesAccordionVisibility, Mode=OneWay}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,24"
            Canvas.ZIndex="10"
            Width="48"
            Height="48"
            Background="{ThemeResource SurfaceElevatedBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource HairlineBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}" Style="{StaticResource IconButtonStyle}">
            <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource IconSizeM}"/>
        </Button>

        <ScrollViewer Grid.Row="8">
            <StackPanel Padding="8">

                <!-- Leer-Hinweis wenn noch kein Scan durchgeführt -->
                <TextBlock
                    x:Uid="LokalArtistsEmpty"
                    Visibility="{x:Bind ViewModel.ArtistsVM.ArtistsEmptyVisibility, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="16,32,16,0"
                    TextWrapping="Wrap"/>

                <!-- Nichts gefunden: anderer Fall als der leere Bestand, deshalb eigener
                     Hinweis samt Weg zurück zum vollständigen Bestand. -->
                <ctrl:EmptyStatePanel
                    x:Name="LokalNoResultsPanel"
                    Glyph="&#xE721;"
                    Visibility="{x:Bind ViewModel.ArtistsVM.NoResultsVisibility, Mode=OneWay}"
                    Margin="16,32,16,0"/>

                <!-- Serien – Abschnitte oberhalb der Aufklappstelle -->
                <ItemsControl
                    x:Name="TopSectionsHost"
                    ItemTemplate="{StaticResource LokalLetterSectionTemplate}"/>

                <!-- Akkordeon: EpisodeAccordionControl + Track-Panel nebeneinander -->
                <Grid
                    x:Name="EpisodeExpansionPanel"
                    Visibility="{x:Bind ViewModel.ArtistsVM.EpisodesAccordionVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Linke Spalte: Episoden-Kacheln ohne Header – Header ist fixiert in Row 4 -->
                    <ctrl:EpisodeAccordionControl
                        x:Name="EpisodeAccordion"
                        Grid.Column="0"
                        EpisodesSource="{x:Bind ViewModel.EpisodesVM.Episodes, Mode=OneWay}"
                        SelectionMode="Single">
                        <ctrl:EpisodeAccordionControl.EpisodeTemplate>
                            <DataTemplate x:DataType="vm:LocalEpisodeCardViewModel">
                                <ctrl:EpisodeTileControl
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                    CoverImage="{x:Bind CoverImage, Mode=OneWay}"
                                    Title="{x:Bind Title, Mode=OneTime}"
                                    StatusTextValue="{x:Bind EpisodeNumberText, Mode=OneTime}"
                                    CompletedVisibility="{x:Bind CompletedCheckVisibility, Mode=OneWay}"
                                    ActionGlyph="&#xE712;">
                                    <ctrl:EpisodeTileControl.ActionFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="LokalEpisodeMarkPlayedItem"
                                                            Tag="{x:Bind EpisodeId, Mode=OneTime}"
                                                            Click="OnEpisodeMarkPlayedClick"/>
                                            <MenuFlyoutItem x:Uid="LokalEpisodeMarkUnplayedItem"
                                                            Tag="{x:Bind EpisodeId, Mode=OneTime}"
                                                            Click="OnEpisodeMarkUnplayedClick"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem x:Uid="LokalEpisodeCoverSelectItem"
                                                            Tag="{x:Bind EpisodeId, Mode=OneTime}"
                                                            Click="OnEpisodeCoverSelectClick"/>
                                            <MenuFlyoutItem x:Uid="LokalEpisodeCoverSearchItem"
                                                            Tag="{x:Bind EpisodeId, Mode=OneTime}"
                                                            Click="OnEpisodeCoverSearchClick"/>
                                        </MenuFlyout>
                                    </ctrl:EpisodeTileControl.ActionFlyout>
                                </ctrl:EpisodeTileControl>
                            </DataTemplate>
                        </ctrl:EpisodeAccordionControl.EpisodeTemplate>
                    </ctrl:EpisodeAccordionControl>

                    <!-- Rechte Spalte: Track-Panel (nur wenn Folge ausgewählt) -->
                    <Grid
                        Grid.Column="1"
                        Width="300"
                        Visibility="{x:Bind ViewModel.TracksVM.TracksAccordionVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Track-Kopfzeile mit Folgenname und Aktions-Buttons -->
                        <Grid Grid.Row="0" Padding="8,8,8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metadaten: Folgennummer · Trackanzahl · Gesamtspielzeit -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{x:Bind ViewModel.TracksVM.TrackPanelSubtitle, Mode=OneWay}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Margin="0,0,0,2"/>

                            <!-- Folgentitel als Überschrift -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.TracksVM.SelectedEpisodeTitle, Mode=OneWay}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"/>

                            <!-- Folge abspielen -->
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                x:Uid="LokalPlayEpisodeButton"
                                Command="{x:Bind ViewModel.TracksVM.PlayEpisodeCommand}"
                                Visibility="{x:Bind ViewModel.TracksVM.TrackActionsVisibility, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                                <FontIcon Glyph="&#xE768;" FontSize="{StaticResource IconSizeS}"/>
                            </Button>

                            <!-- Tracks im Tag-Manager bearbeiten -->
                            <Button
                                Grid.Row="1"
                                Grid.Column="2"
                                x:Uid="MediathekLokalEpisodeTagManagerButton"
                                Command="{x:Bind ViewModel.TracksVM.OpenAllEpisodeTracksCommand}"
                                Visibility="{x:Bind ViewModel.TracksVM.TrackActionsVisibility, Mode=OneWay}" Style="{StaticResource IconButtonStyle}">
                                <FontIcon Glyph="&#xE8EC;" FontSize="{StaticResource IconSizeS}"/>
                            </Button>
                        </Grid>

                        <!-- Leer-Hinweis für Tracks -->
                        <TextBlock
                            Grid.Row="1"
                            x:Uid="LokalTracksEmpty"
                            Visibility="{x:Bind ViewModel.TracksVM.TracksEmptyVisibility, Mode=OneWay}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="8,16,8,0"
                            TextWrapping="Wrap"/>

                        <!-- Track-Liste -->
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.TracksVM.Tracks, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocalTrackRowViewModel">
                                    <Grid Padding="0,4" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind TrackNumber, Mode=OneTime}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneTime}"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind DurationText, Mode=OneTime}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"/>
                                        <Button
                                            Grid.Column="3"
                                            x:Uid="MediathekLokalTrackTagManagerButton"
                                            Command="{x:Bind OpenInTagManagerCommand}" Style="{StaticResource IconButtonStyle}">
                                            <FontIcon Glyph="&#xEBBE;" FontSize="{StaticResource IconSizeS}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Serien – Fortsetzung unterhalb der Aufklappstelle. Gleiche Vorlage wie
                     oben, damit Überschriften, Indikatoren und Kontextmenü übereinstimmen. -->
                <ItemsControl
                    x:Name="BottomSectionsHost"
                    ItemTemplate="{StaticResource LokalLetterSectionTemplate}"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</Page>
