<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ForestSignal ist ein dunkles Theme – beide Dictionaries zeigen dieselbe Palette.
             RequestedTheme wird vom ThemeService auf Dark gesetzt. -->

        <!-- Light-Key ist erforderlich, damit WinUI 3 nicht in den Fallback geht.
             ForestSignal ist ein fixes Dunkles Theme – identische Werte wie Dark. -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0F1A14"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"  Color="#16241C"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#16241C"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground"      Color="#0F1A14"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush"           Color="#16241C"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#16241C"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1E2F25"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush"         Color="#1E2F25"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"       Color="#16241C"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"            Color="#E6F2EC"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush"          Color="#9FB7AA"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"           Color="#8FA49A"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush"           Color="#6F8F80"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"       Color="#1E2F25"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"          Color="#22352B"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"          Color="#3FA37A"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"        Color="#52B88E"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"         Color="#2F7D5D"/>
            <SolidColorBrush x:Key="AppBackgroundBrush"                   Color="#0F1A14"/>
            <SolidColorBrush x:Key="SurfaceBrush"                         Color="#0F1A14"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush"                 Color="#16241C"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush"                    Color="#1E2F25"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"                     Color="#E6F2EC"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"                   Color="#9FB7AA"/>
            <SolidColorBrush x:Key="TextTertiaryBrush"                    Color="#8FA49A"/>
            <SolidColorBrush x:Key="TextDisabledBrush"                    Color="#6F8F80"/>
            <SolidColorBrush x:Key="TextOnAccentBrush"                    Color="#0F1A14"/>
            <SolidColorBrush x:Key="AccentPrimaryBrush"                   Color="#3FA37A"/>
            <SolidColorBrush x:Key="AccentPrimaryHoverBrush"              Color="#52B88E"/>
            <SolidColorBrush x:Key="AccentPrimaryPressedBrush"            Color="#2F7D5D"/>
            <SolidColorBrush x:Key="AccentPrimaryDisabledBrush"           Color="#1C4A38"/>
            <!-- Schaltflächen: die Schlüssel, die WinUI liest. Eigene Namen bleiben wirkungslos —
                 die Vorlage löst sie im eigenen Wörterbuch auf und kommt hier nie an. -->
            <SolidColorBrush x:Key="ButtonBackground"                      Color="#1E2F25"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"           Color="#283F31"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"               Color="#304B3B"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled"              Color="#1E2F25"/>
            <SolidColorBrush x:Key="ButtonForeground"                      Color="#E6F2EC"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"           Color="#E6F2EC"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed"               Color="#E6F2EC"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled"              Color="#6F8F80"/>
            <SolidColorBrush x:Key="ButtonBorderBrush"                     Color="#517F64"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"          Color="#71A587"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"              Color="#71A587"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled"             Color="#6F8F80"/>

            <!-- Primäraktion: Akzentfläche, in allen Zuständen aus der Palette. -->
            <SolidColorBrush x:Key="AccentButtonBackground"                Color="#3FA37A"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"     Color="#52B88E"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"         Color="#2F7D5D"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled"        Color="#1C4A38"/>
            <SolidColorBrush x:Key="AccentButtonForeground"                Color="#0F1A14"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver"     Color="#0F1A14"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed"         Color="#0F1A14"/>
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled"        Color="#6F8F80"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush"               Color="#3FA37A"/>

            <!-- Umschalter im gehakten Zustand, etwa der aktive Filter. Ohne diese Schlüssel
                 färbt Windows sie in seiner eigenen Akzentfarbe — auf jedem Rechner anders. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"            Color="#3FA37A"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#52B88E"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"     Color="#2F7D5D"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"            Color="#0F1A14"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0F1A14"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"     Color="#0F1A14"/>

            <!-- Stille Flächen und Ränder, die die Pfeil-Schaltflächen benutzen. -->
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"         Color="#283F31"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"        Color="#517F64"/>
            <SolidColorBrush x:Key="CardBackgroundBrush"                  Color="#16241C"/>
            <SolidColorBrush x:Key="CardBackgroundHoverBrush"             Color="#1E2F25"/>
            <SolidColorBrush x:Key="CardBorderBrush"                      Color="#22352B"/>
            <SolidColorBrush x:Key="InputBackgroundBrush"                 Color="#16241C"/>
            <SolidColorBrush x:Key="InputBackgroundHoverBrush"            Color="#1A2920"/>
            <SolidColorBrush x:Key="InputBackgroundFocusBrush"            Color="#16241C"/>
            <SolidColorBrush x:Key="InputBackgroundDisabledBrush"         Color="#111F17"/>
            <SolidColorBrush x:Key="InputBorderBrush"                     Color="#4B755F"/>
            <SolidColorBrush x:Key="InputBorderHoverBrush"                Color="#548A6A"/>
            <SolidColorBrush x:Key="InputBorderFocusBrush"                Color="#3FA37A"/>

            <!-- Dieselben Farben unter den Namen, die WinUI wirklich liest. Die eigenen
                 Input-Schlüssel darüber liest nur das Suchfeld; Text-, Kennwort-, Zahlen-
                 und Auswahlfelder folgten sonst der Vorgabe des Rahmenwerks. -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="InputBorderBrush"/>
            <SolidColorBrush x:Key="HighlightBrush"                       Color="#1E4A3A"/>
            <SolidColorBrush x:Key="ActiveBrush"                          Color="#3FA37A"/>
            <SolidColorBrush x:Key="ActiveBackgroundBrush"                Color="#152E23"/>
            <SolidColorBrush x:Key="SelectionBackgroundBrush"             Color="#152E23"/>
            <SolidColorBrush x:Key="SelectionBorderBrush"                 Color="#3FA37A"/>

            <!-- Status: nie allein über Farbe ausgedrückt, immer zusätzlich über Wort oder Zeichen. -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6FBF8A"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#E0A94F"/>
            <SolidColorBrush x:Key="StatusErrorBrush"   Color="#E8736B"/>

            <!-- Seitenleiste: der aktive Punkt hebt sich über die Fläche ab, nicht über die Schrift allein. -->
            <SolidColorBrush x:Key="NavigationViewPaneBorderBrush" Color="#22352B"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground"                    Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"         Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"             Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"            Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed"     Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled"            Color="#6F8F80"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled"    Color="#6F8F80"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForeground"                    Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver"         Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed"             Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected"            Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed"     Color="#9FB7AA"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundDisabled"            Color="#6F8F80"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedDisabled"    Color="#6F8F80"/>
            <SolidColorBrush x:Key="NavigationViewItemBackground"                    Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"         Color="#1E2F25"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"             Color="#0F1A14"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"            Color="#22352B"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3D4D44"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"     Color="#0F1A14"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"            Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled"    Color="#1E2F25"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"      Color="#3FA37A"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver"       Color="#E6F2EC"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed"           Color="#9FB7AA"/>

            <!-- Kachel der Linie: Kopf farbig, Körper hell — nicht umgekehrt. -->
            <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="#3FA37A"/>
            <SolidColorBrush x:Key="CardHeaderForegroundBrush" Color="#0F1A14"/>
            <SolidColorBrush x:Key="CardBodyBackgroundBrush"   Color="#16241C"/>
            <SolidColorBrush x:Key="CardBodyForegroundBrush"   Color="#E6F2EC"/>
            <FontFamily x:Key="ThemeFontFamily">Noto Sans</FontFamily>
            <FontFamily x:Key="ThemeMonoFontFamily">Fira Code</FontFamily>
            <!-- ContentControlThemeFontFamily überschreibt den WinUI-3-Standard,
                 damit alle built-in Styles (BodyTextBlock, Caption usw.) die Theme-Schrift verwenden -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Noto Sans</FontFamily>

        </ResourceDictionary>

