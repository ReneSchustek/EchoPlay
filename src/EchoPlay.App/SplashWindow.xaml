<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoPlay.App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EchoPlay">

    <Grid Background="{StaticResource BrandSurfaceBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <Image
                x:Name="LogoImage"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                Stretch="Uniform"/>

            <TextBlock
                Text="EchoPlay"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{StaticResource BrandPrimaryBrush}"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Uid="SplashTagline"
                FontSize="13"
                Foreground="{StaticResource BrandSecondaryBrush}"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="VersionTextBlock"
                FontSize="11"
                Foreground="{StaticResource BrandMutedBrush}"
                HorizontalAlignment="Center"/>

            <ProgressBar
                IsIndeterminate="True"
                Width="200"
                Margin="0,8,0,0"
                Foreground="{StaticResource BrandPrimaryBrush}"/>

            <TextBlock
                x:Name="StatusTextBlock"
                FontSize="11"
                Foreground="{StaticResource BrandSecondaryBrush}"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>

        </StackPanel>
    </Grid>

</Window>
