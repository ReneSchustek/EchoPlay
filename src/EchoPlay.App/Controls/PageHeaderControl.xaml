<?xml version="1.0" encoding="utf-8"?>
<!--
    Seitenkopf der Gestaltungslinie: Titel, darunter eine Zeile, die sagt, was man hier
    tut, rechts die Primäraktion. Steht auf jeder Listen-Seite an derselben Stelle — wer
    die Anordnung umstellt, nimmt die Wiedererkennung weg, um die es hier geht.
-->
<UserControl
    x:Class="EchoPlay.App.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{StaticResource StackGapM}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource PageSubtitleTextStyle}"
                Visibility="Collapsed"/>
        </StackPanel>

        <Button
            x:Name="PrimaryActionButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource PrimaryActionButtonStyle}"
            Click="OnPrimaryActionClick"
            Visibility="Collapsed"/>
    </Grid>

</UserControl>
