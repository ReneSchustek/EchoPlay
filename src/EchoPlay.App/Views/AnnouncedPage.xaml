<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EchoPlay.App.Views.AnnouncedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:EchoPlay.App.ViewModels"
    xmlns:ctrl="using:EchoPlay.App.Controls">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctrl:HelpButtonControl TipUid="HelpTipAnnounced"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,16,0" Canvas.ZIndex="1"/>

        <ctrl:PageHeaderControl
            x:Name="AnnouncedHeader"
            Grid.Row="0"
            Margin="0,0,56,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <ProgressRing IsActive="True" Width="24" Height="24" HorizontalAlignment="Left"
                              Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"/>

                <TextBlock
                    x:Uid="AnnouncedEmpty"
                    Visibility="{x:Bind ViewModel.EmptyHintVisibility, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Je Monat eine Überschrift und die Kacheln in Zeilen umbrochen; ein Klick
                     öffnet die Serie. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AnnouncedMonthGroupViewModel">
                            <StackPanel Margin="0,0,0,16" AutomationProperties.Name="{x:Bind Label}">
                                <TextBlock Text="{x:Bind Label}" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                                <GridView
                                    ItemsSource="{x:Bind Items}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnItemClick"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:ReleaseCalendarItemViewModel">
                                            <ctrl:ReleaseTileControl Item="{x:Bind}" AutomationProperties.Name="{x:Bind AutomationName}"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
