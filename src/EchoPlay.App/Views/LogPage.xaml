<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EchoPlay.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EchoPlay.App.ViewModels"
    xmlns:ctrl="using:EchoPlay.App.Controls"
    xmlns:log="using:EchoPlay.Logger.Models">

    <Page.Resources>
        <DataTemplate x:Key="LogEntryTemplate" x:DataType="vm:LogEntryViewModel">
            <Grid ColumnSpacing="12" Padding="4,2" AutomationProperties.Name="{x:Bind Message}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Zeitstempel -->
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind Timestamp}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>

                <!-- Level-Badge -->
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Level}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <!-- Kategorie -->
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind Category}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"/>

                <!-- Nachricht -->
                <TextBlock
                    Grid.Column="3"
                    Text="{x:Bind Message}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind Message}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Aufbau der Gestaltungslinie, von oben: Seitenkopf, Suchfeld, Filterleiste,
             dann die Meldungen. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Seitenkopf: Titel, Zweck der Seite, rechts das Leeren der Anzeige -->
        <ctrl:PageHeaderControl
            x:Name="ProtokollHeader"
            Grid.Row="0"
            Margin="16,12,16,0"
            ActionCommand="{x:Bind ViewModel.ClearCommand}"/>

        <!-- Suchfeld, Live-Schalter -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12"
            Padding="16,8,16,4">

            <ctrl:SearchBoxControl
                x:Name="ProtokollSearchField"
                Width="300"
                VerticalAlignment="Center"
                SearchText="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/>

            <!-- Negatives Margin kompensiert den fest eingebauten Innenabstand des ToggleSwitch-Stils -->
            <ToggleSwitch
                x:Uid="ProtokollLiveToggle"
                IsOn="{x:Bind ViewModel.IsLiveActive, Mode=OneWay}"
                Toggled="OnLiveToggled"
                VerticalAlignment="Center"
                Margin="0,-6,0,-6"/>

        </StackPanel>

        <!-- Stufen als Chips. Sie schließen einander aus – eine Meldung hat genau eine
             Stufe. Kein aktiver Chip heißt alle. -->
        <ctrl:FilterBarControl
            x:Name="ProtokollFilterBar"
            Grid.Row="2"
            Margin="16,0,16,4"
            FilterToggled="OnFilterToggled"/>

        <!-- Nichts gefunden: eigener Hinweis, wenn Meldungen vorliegen, aber Suche oder
             Stufe keine übrig lassen. -->
        <ctrl:EmptyStatePanel
            x:Name="ProtokollNoResultsPanel"
            Grid.Row="3"
            Glyph="&#xE721;"
            VerticalAlignment="Top"
            Margin="16,32,16,0"
            Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}"/>

        <!-- Log-Einträge – neueste oben, kein Selektionsstatus nötig -->
        <ListView
            Grid.Row="3"
            x:Name="LogListView"
            ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}"
            ItemTemplate="{StaticResource LogEntryTemplate}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="MinHeight" Value="28"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
