<?xml version="1.0" encoding="utf-8"?>
<!-- Wiederverwendbare horizontale Kachelreihe mit Pfeil-Buttons.
     Wird im Dashboard für Neuerscheinungen, Weiterhören, In-Progress und
     Zuletzt-gehört verwendet. Pfeile blenden sich automatisch ein,
     sobald die Reihe links bzw. rechts überlappt. -->
<UserControl
    x:Class="EchoPlay.App.Controls.HorizontalTileRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Dezenter Pfeil-Button: dezelt sich in Light/Dark, kompatibel mit Fluent. -->
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="LeftArrow"
                x:Uid="TileRowScrollLeftButton"
                Grid.Column="0"
                Style="{StaticResource ScrollArrowButtonStyle}"
                Click="OnLeftArrowClick"
                Visibility="Collapsed"
                VerticalAlignment="Center">
            <FontIcon Glyph="&#xE76B;" FontSize="{StaticResource IconSizeS}"/>
        </Button>

        <ScrollViewer x:Name="TilesScrollViewer"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
            <ItemsControl x:Name="TilesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="RightArrow"
                x:Uid="TileRowScrollRightButton"
                Grid.Column="2"
                Style="{StaticResource ScrollArrowButtonStyle}"
                Click="OnRightArrowClick"
                Visibility="Collapsed"
                VerticalAlignment="Center">
            <FontIcon Glyph="&#xE76C;" FontSize="{StaticResource IconSizeS}"/>
        </Button>
    </Grid>
</UserControl>
