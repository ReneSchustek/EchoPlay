<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <!-- Werkzeug, kein Produktivcode: Analyzer-Strenge des Zielrepos gilt hier nicht. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!--
      NU1903 betrifft die MSBuild-Pakete, die Microsoft.CodeAnalysis.Workspaces.MSBuild
      transitiv mitbringt. Sie werden hier nur zum Kompilieren gebraucht: Zur Laufzeit lädt
      MSBuildLocator die installierte SDK-Instanz, nicht diese Assemblies. Das Werkzeug läuft
      lokal auf eigenem Quellcode und verarbeitet keine fremden Eingaben.
    -->
    <NoWarn>$(NoWarn);CA1305;CA1861;CS1591;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

</Project>
