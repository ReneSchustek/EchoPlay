<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- PaperCoffee ist ein helles Theme – beide Dictionaries zeigen dieselbe Palette.
             RequestedTheme wird vom ThemeService auf Light gesetzt. -->

        <ResourceDictionary x:Key="Light">

            <!-- WinUI 3-Ressourcen überschreiben -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFFBF2"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"  Color="#FCF5E5"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FCF5E5"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground"      Color="#FFFBF2"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush"           Color="#FCF5E5"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#FCF5E5"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F3EBDD"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush"         Color="#F3EBDD"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"       Color="#FCF5E5"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"            Color="#4A3F35"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush"          Color="#7A6F63"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"           Color="#9B9085"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush"           Color="#C2B8AE"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"       Color="#D8C9BA"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"          Color="#E6DCCD"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"          Color="#A06040"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"        Color="#B87455"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"         Color="#8C5036"/>

            <!-- Background / Surfaces -->
            <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#FFFBF2"/>
            <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFBF2"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush"   Color="#FCF5E5"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#F3EBDD"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#4A3F35"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7A6F63"/>
            <SolidColorBrush x:Key="TextTertiaryBrush"  Color="#786D62"/>
            <SolidColorBrush x:Key="TextDisabledBrush"  Color="#C2B8AE"/>
            <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF"/>

            <!-- Accent -->
            <SolidColorBrush x:Key="AccentPrimaryBrush"         Color="#A06040"/>
            <SolidColorBrush x:Key="AccentPrimaryHoverBrush"    Color="#B87455"/>
            <SolidColorBrush x:Key="AccentPrimaryPressedBrush"  Color="#8C5036"/>
            <SolidColorBrush x:Key="AccentPrimaryDisabledBrush" Color="#E6D5C8"/>

            <!-- Schaltflächen: die Schlüssel, die WinUI liest. Eigene Namen bleiben wirkungslos —
                 die Vorlage löst sie im eigenen Wörterbuch auf und kommt hier nie an. -->
            <SolidColorBrush x:Key="ButtonBackground"                      Color="#F3EBDD"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"           Color="#ECE0CA"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"               Color="#E7D7BB"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled"              Color="#F3EBDD"/>
            <SolidColorBrush x:Key="ButtonForeground"                      Color="#4A3F35"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"           Color="#4A3F35"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed"               Color="#4A3F35"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled"              Color="#C2B8AE"/>
            <SolidColorBrush x:Key="ButtonBorderBrush"                     Color="#A8803B"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"          Color="#87672F"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"              Color="#87672F"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled"             Color="#C2B8AE"/>

            <!-- Primäraktion: Akzentfläche, in allen Zuständen aus der Palette. -->
            <SolidColorBrush x:Key="AccentButtonBackground"                Color="#A06040"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"     Color="#B87455"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"         Color="#8C5036"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled"        Color="#E6D5C8"/>
            <SolidColorBrush x:Key="AccentButtonForeground"                Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver"     Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled"        Color="#C2B8AE"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush"               Color="#A06040"/>

            <!-- Umschalter im gehakten Zustand, etwa der aktive Filter. Ohne diese Schlüssel
                 färbt Windows sie in seiner eigenen Akzentfarbe — auf jedem Rechner anders. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"            Color="#A06040"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#B87455"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"     Color="#8C5036"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"            Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"     Color="#FFFFFF"/>

            <!-- Stille Flächen und Ränder, die die Pfeil-Schaltflächen benutzen. -->
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"         Color="#ECE0CA"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"        Color="#A8803B"/>

            <!-- Cards -->
            <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#FCF5E5"/>
            <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#F3EBDD"/>
            <SolidColorBrush x:Key="CardBorderBrush"          Color="#E6DCCD"/>

            <!-- Inputs -->
            <SolidColorBrush x:Key="InputBackgroundBrush"         Color="#FCF5E5"/>
            <SolidColorBrush x:Key="InputBackgroundHoverBrush"    Color="#F3EBDD"/>
            <SolidColorBrush x:Key="InputBackgroundFocusBrush"    Color="#FCF5E5"/>
            <SolidColorBrush x:Key="InputBackgroundDisabledBrush" Color="#F0E6DA"/>
            <SolidColorBrush x:Key="InputBorderBrush"             Color="#A88765"/>
            <SolidColorBrush x:Key="InputBorderHoverBrush"        Color="#907459"/>
            <SolidColorBrush x:Key="InputBorderFocusBrush"        Color="#A06040"/>

            <!-- Dieselben Farben unter den Namen, die WinUI wirklich liest. Die eigenen
                 Input-Schlüssel darüber liest nur das Suchfeld; Text-, Kennwort-, Zahlen-
                 und Auswahlfelder folgten sonst der Vorgabe des Rahmenwerks. -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="InputBorderBrush"/>

            <!-- Selection / Highlight -->
            <SolidColorBrush x:Key="HighlightBrush"           Color="#606C38"/>
            <SolidColorBrush x:Key="ActiveBrush"              Color="#A06040"/>
            <SolidColorBrush x:Key="ActiveBackgroundBrush"    Color="#EFE3D6"/>
            <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#EFE3D6"/>
            <SolidColorBrush x:Key="SelectionBorderBrush"     Color="#A06040"/>

            <!-- Typografie: IBM Plex Sans (warm, analog, leichtes Buch-Gefühl) -->
            <!-- Download: https://fonts.google.com/specimen/IBM+Plex+Sans -->
            <!-- TTF nach Assets/Fonts/ kopieren und im .csproj als Content deklarieren -->

            <!-- Status: nie allein über Farbe ausgedrückt, immer zusätzlich über Wort oder Zeichen. -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#1E7A45"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#8A5A00"/>
            <SolidColorBrush x:Key="StatusErrorBrush"   Color="#B3261E"/>

            <!-- Seitenleiste: der aktive Punkt hebt sich über die Fläche ab, nicht über die Schrift allein. -->
            <SolidColorBrush x:Key="NavigationViewPaneBorderBrush" Color="#E6DCCD"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground"                    Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"         Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"             Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"            Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed"     Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled"            Color="#C2B8AE"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled"    Color="#C2B8AE"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForeground"                    Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver"         Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed"             Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected"            Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed"     Color="#7A6F63"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundDisabled"            Color="#C2B8AE"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedDisabled"    Color="#C2B8AE"/>
            <SolidColorBrush x:Key="NavigationViewItemBackground"                    Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"         Color="#F3EBDD"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"             Color="#FFFBF2"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"            Color="#E6DCCD"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#CAC2B4"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"     Color="#FFFBF2"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"            Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled"    Color="#F3EBDD"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"      Color="#A06040"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver"       Color="#4A3F35"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed"           Color="#7A6F63"/>

            <!-- Kachel der Linie: Kopf farbig, Körper hell — nicht umgekehrt. -->
            <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="#A06040"/>
            <SolidColorBrush x:Key="CardHeaderForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBodyBackgroundBrush"   Color="#FCF5E5"/>
            <SolidColorBrush x:Key="CardBodyForegroundBrush"   Color="#4A3F35"/>
            <FontFamily x:Key="ThemeFontFamily">IBM Plex Sans</FontFamily>
            <FontFamily x:Key="ThemeMonoFontFamily">IBM Plex Mono</FontFamily>
            <!-- ContentControlThemeFontFamily überschreibt den WinUI-3-Standard,
                 damit alle built-in Styles (BodyTextBlock, Caption usw.) die Theme-Schrift verwenden -->
            <FontFamily x:Key="ContentControlThemeFontFamily">IBM Plex Sans</FontFamily>

        </ResourceDictionary>

