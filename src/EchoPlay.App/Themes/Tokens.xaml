<!--
    Theme-unabhängige Bausteine der Gestaltungslinie: Abstände, Radien, Schriftgrößen,
    Randstärken.

    Warum hier und nicht in den sechs Paletten: Diese Werte ändern sich mit dem gewählten
    Theme nicht. Nur Farben wechseln. Stünden sie in jeder Palette, müsste eine Änderung an
    der Kachelform sechsmal nachgezogen werden — und wäre nach dem dritten Mal uneinheitlich.

    Enthält bewusst keinen Farbwert. Farben stehen in den Paletten, die Markenfarben des
    Startbilds in Brand.xaml.

    Wird in App.xaml vor den Paletten eingehängt und bleibt dort dauerhaft: ThemeService
    entfernt beim Wechsel nur Dictionaries, deren Quelle einen Theme-Namen trägt.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Abstände ───────────────────────────────────────────────────────────
         Eine Skala statt frei gewählter Zahlen. Grundabstand ist 8; alles andere
         ist ein Vielfaches davon. Gleiche Abstände sehen dadurch überall gleich
         aus, und eine Korrektur wirkt an einer Stelle. -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,32</Thickness>
    <Thickness x:Key="StackGapS">0,0,0,8</Thickness>
    <Thickness x:Key="StackGapM">0,0,0,16</Thickness>

    <!-- ── Radien ─────────────────────────────────────────────────────────────
         Die Linie hält Ecken klein (4–6 px): die Marke ist Industrie, nicht
         Spielzeug. ControlCornerRadius ist ein WinUI-eigener Schlüssel und wird
         hier bewusst belegt, damit auch Schaltflächen und Eingabefelder aus dem
         Rahmenwerk der Linie folgen, ohne dass jede Ansicht das einzeln setzt. -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardHeaderCornerRadius">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="CardBodyCornerRadius">0,0,6,6</CornerRadius>

    <!-- ── Schriftgrößen ──────────────────────────────────────────────────────
         Die Schriftfamilie steht absichtlich nicht hier, sondern in jeder Palette:
         Sie ist bei EchoPlay Teil des Themes (Roboto, Merriweather Sans, …) und
         damit gerade kein theme-unabhängiger Wert. Die Größen sind es sehr wohl. -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeader">28</x:Double>

    <!-- Zeilenhöhe 1.65 im Fließtext, auf die Körpergröße gerechnet. -->
    <x:Double x:Key="LineHeightBody">23</x:Double>

    <!-- Abschnittsüberschriften sind klein, gesperrt und in Großbuchstaben — das
         auffälligste Merkmal der Linie. Sie ersetzen große Zwischenüberschriften.
         WinUI rechnet CharacterSpacing in Tausendstel des Schriftgrads: 0.08em = 80. -->
    <x:Int32 x:Key="SectionHeaderCharacterSpacing">80</x:Int32>

    <!-- ── Kanten und Größen ──────────────────────────────────────────────────
         Flächen trennen sich über Farbe und Haarlinie, nie über Schlagschatten. -->
    <Thickness x:Key="HairlineBorderThickness">1</Thickness>
    <Thickness x:Key="FocusVisualThickness">2</Thickness>

    <!-- Untergrenze für ein Bedienziel. Darunter trifft es nicht mehr zuverlässig, wer
         keine ruhige Hand oder einen Finger statt einer Maus benutzt. -->
    <x:Double x:Key="TouchTargetMinSize">40</x:Double>
    <Thickness x:Key="IconButtonPadding">8</Thickness>

    <x:Double x:Key="IconSizeS">14</x:Double>
    <x:Double x:Key="IconSizeM">18</x:Double>
    <x:Double x:Key="IconSizeL">24</x:Double>

    <!-- Das Kachelsymbol sitzt groß und zurückgenommen im Kopf, rechts angeschnitten. -->
    <x:Double x:Key="TileHeaderIconSize">48</x:Double>
    <x:Double x:Key="TileHeaderIconOpacity">0.25</x:Double>

    <x:Double x:Key="RowHeightDefault">36</x:Double>

</ResourceDictionary>
