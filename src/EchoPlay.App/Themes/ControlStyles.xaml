<!--
    Gemeinsame Text- und Bedienelement-Stile der Gestaltungslinie.

    Warum als benannte Stile und nicht als Vorgabe für alle Textblöcke: Ein pauschaler
    Standardstil schlägt die Vererbung und färbt damit gerade die Beschriftungen um, die
    absichtlich auf einer farbigen Fläche stehen — weiße Schrift auf dem Kachelkopf würde
    zu dunkler Schrift auf dunklem Grund. Der Weg ist der Stil an der Stelle, nicht die
    Gießkanne.

    Farben stehen hier ausschließlich als Verweis auf die Palette, nie als Wert.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Seitenkopf ─────────────────────────────────────────────────────────
         Großer Titel, darunter eine Zeile, die sagt, was man hier tut. -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Abschnittsüberschrift ──────────────────────────────────────────────
         Klein, in Großbuchstaben, gesperrt und gedämpft. Das ist das auffälligste
         Merkmal der Linie und ersetzt große Zwischenüberschriften.

         Die Großschreibung steht nicht im Stil: Ein TextBlock in WinUI kennt keine
         Umwandlung der Schreibweise bei der Darstellung. Der Text wird deshalb bereits
         großgeschrieben übergeben — bei übersetzten Texten in der Ressourcendatei. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="{StaticResource SectionHeaderCharacterSpacing}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}"/>
    </Style>

    <!-- ── Fließtext und Nebentext ────────────────────────────────────────────
         Jeder Textblock bekommt einen Stil: Ein Bedienelement ohne Stil erbt nicht die
         Textfarbe der Anwendung, sondern die Vorgabe des Rahmenwerks — im dunklen
         Erscheinungsbild steht die Stelle dann schwarz auf dunklem Grund und ist weg. -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ── Schaltfläche mit reinem Symbol ─────────────────────────────────────
         Ein Symbol allein ergibt eine sehr kleine Fläche: Zeichen plus Innenabstand
         landen bei rund 30 Punkten. Für ein Bedienziel sind 40 die Untergrenze — darunter
         trifft es nicht mehr zuverlässig, wer keine ruhige Hand oder einen Finger statt
         einer Maus benutzt.

         Als Stil und nicht als Angabe an jeder Schaltfläche, weil es sonst bei der
         nächsten neuen wieder vergessen wird. Die Beschriftung für die Sprachausgabe
         bleibt Sache der Stelle — sie ist überall eine andere. -->
    <!-- ── Primäraktion ──────────────────────────────────────────────────────
         Die eine hervorgehobene Schaltfläche einer Seite, rechts im Seitenkopf.

         Setzt auf den eingebauten AccentButtonStyle auf. Der frühere Kommentar begründete
         das Gegenteil: Alle sechs Paletten seien gleichzeitig eingehängt, deshalb behielte
         die Schaltfläche die Akzentfarbe der zuletzt deklarierten. Nachgemessen am
         13.08.2026 stimmt das nicht mehr — der Theme-Dienst entfernt beim Start alle
         Paletten und hängt genau eine ein (ThemeService.RemoveAllThemeDictionaries, dann
         AddThemeDictionary). Und seit die Schaltflächen aus der Palette kommen, belegt jede
         Palette AccentButtonBackground samt PointerOver, Pressed und Disabled selbst.

         Der eigene Stil hatte dafür einen sichtbaren Preis: Die Zustände der
         Standardvorlage setzen die Fläche unmittelbar am Inhalt und gewinnen gegen jeden
         Setter. Beim Überfahren galt deshalb die stille Fläche des gewöhnlichen Knopfes —
         die Primäraktion kippte von Akzent auf Grau. Über den Basisstil greifen die
         Zustände der Palette. -->
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinSize}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ── Blätterpfeil an einer waagerechten Kachelreihe ────────────────────
         Schmal und hoch, damit er neben den Kacheln steht, ohne sie zu verdecken. Die
         48 Punkte Höhe sind das Bedienziel; die Breite darf darunter bleiben, weil der
         Pfeil in einer Reihe sitzt, die selbst schon Zielfläche ist.

         Stand zweimal wortgleich in zwei Ansichten — einmal davon mit fest verdrahtetem
         Eckenradius. Ein Stil, der an zwei Orten gepflegt werden muss, läuft auseinander;
         genau das war dort schon passiert. -->
    <Style x:Key="ScrollArrowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMinSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMinSize}"/>
        <Setter Property="Padding" Value="{StaticResource IconButtonPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
