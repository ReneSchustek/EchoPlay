<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- AmberWhiskey ist ein dunkles Theme – beide Dictionaries zeigen dieselbe Palette.
             RequestedTheme wird vom ThemeService auf Dark gesetzt. -->

        <!-- Light-Key ist erforderlich, damit WinUI 3 nicht in den Fallback geht. -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1A1410"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"  Color="#241B16"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#241B16"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground"      Color="#1A1410"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush"           Color="#241B16"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#241B16"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2E231C"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush"         Color="#2E231C"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"       Color="#241B16"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"            Color="#F3E9DC"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush"          Color="#BFA58A"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"           Color="#A58C73"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush"           Color="#8C735C"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"       Color="#2E231C"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"          Color="#3A2A1F"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"          Color="#C27A2C"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"        Color="#D48A3A"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"         Color="#9B5F20"/>
            <SolidColorBrush x:Key="AppBackgroundBrush"                   Color="#1A1410"/>
            <SolidColorBrush x:Key="SurfaceBrush"                         Color="#1A1410"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush"                 Color="#241B16"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush"                    Color="#2E231C"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"                     Color="#F3E9DC"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"                   Color="#BFA58A"/>
            <SolidColorBrush x:Key="TextTertiaryBrush"                    Color="#A58C73"/>
            <SolidColorBrush x:Key="TextDisabledBrush"                    Color="#8C735C"/>
            <SolidColorBrush x:Key="TextOnAccentBrush"                    Color="#1A1410"/>
            <SolidColorBrush x:Key="AccentPrimaryBrush"                   Color="#C27A2C"/>
            <SolidColorBrush x:Key="AccentPrimaryHoverBrush"              Color="#D48A3A"/>
            <SolidColorBrush x:Key="AccentPrimaryPressedBrush"            Color="#9B5F20"/>
            <SolidColorBrush x:Key="AccentPrimaryDisabledBrush"           Color="#4A2E10"/>
            <!-- Schaltflächen: die Schlüssel, die WinUI liest. Eigene Namen bleiben wirkungslos —
                 die Vorlage löst sie im eigenen Wörterbuch auf und kommt hier nie an. -->
            <SolidColorBrush x:Key="ButtonBackground"                      Color="#2E231C"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"           Color="#3E2F26"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"               Color="#4B392D"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled"              Color="#2E231C"/>
            <SolidColorBrush x:Key="ButtonForeground"                      Color="#F3E9DC"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"           Color="#F3E9DC"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed"               Color="#F3E9DC"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled"              Color="#8C735C"/>
            <SolidColorBrush x:Key="ButtonBorderBrush"                     Color="#8A6954"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"          Color="#AB8974"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed"              Color="#AB8974"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled"             Color="#8C735C"/>

            <!-- Primäraktion: Akzentfläche, in allen Zuständen aus der Palette. -->
            <SolidColorBrush x:Key="AccentButtonBackground"                Color="#C27A2C"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver"     Color="#D48A3A"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"         Color="#9B5F20"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled"        Color="#4A2E10"/>
            <SolidColorBrush x:Key="AccentButtonForeground"                Color="#1A1410"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver"     Color="#1A1410"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed"         Color="#1A1410"/>
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled"        Color="#8C735C"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush"               Color="#C27A2C"/>

            <!-- Umschalter im gehakten Zustand, etwa der aktive Filter. Ohne diese Schlüssel
                 färbt Windows sie in seiner eigenen Akzentfarbe — auf jedem Rechner anders. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"            Color="#C27A2C"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D48A3A"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"     Color="#9B5F20"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked"            Color="#1A1410"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#1A1410"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed"     Color="#1A1410"/>

            <!-- Stille Flächen und Ränder, die die Pfeil-Schaltflächen benutzen. -->
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"         Color="#3E2F26"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"        Color="#8A6954"/>
            <SolidColorBrush x:Key="CardBackgroundBrush"                  Color="#241B16"/>
            <SolidColorBrush x:Key="CardBackgroundHoverBrush"             Color="#2E231C"/>
            <SolidColorBrush x:Key="CardBorderBrush"                      Color="#3A2A1F"/>
            <SolidColorBrush x:Key="InputBackgroundBrush"                 Color="#241B16"/>
            <SolidColorBrush x:Key="InputBackgroundHoverBrush"            Color="#291F18"/>
            <SolidColorBrush x:Key="InputBackgroundFocusBrush"            Color="#241B16"/>
            <SolidColorBrush x:Key="InputBackgroundDisabledBrush"         Color="#1E1610"/>
            <SolidColorBrush x:Key="InputBorderBrush"                     Color="#866147"/>
            <SolidColorBrush x:Key="InputBorderHoverBrush"                Color="#9E7354"/>
            <SolidColorBrush x:Key="InputBorderFocusBrush"                Color="#C27A2C"/>

            <!-- Dieselben Farben unter den Namen, die WinUI wirklich liest. Die eigenen
                 Input-Schlüssel darüber liest nur das Suchfeld; Text-, Kennwort-, Zahlen-
                 und Auswahlfelder folgten sonst der Vorgabe des Rahmenwerks. -->
            <StaticResource x:Key="TextControlBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="InputBackgroundBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="InputBackgroundHoverBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="InputBackgroundFocusBrush"/>
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="InputBackgroundDisabledBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBorderBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InputBorderHoverBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="InputBorderFocusBrush"/>
            <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="InputBorderBrush"/>
            <SolidColorBrush x:Key="HighlightBrush"                       Color="#6B3E1A"/>
            <SolidColorBrush x:Key="ActiveBrush"                          Color="#C27A2C"/>
            <SolidColorBrush x:Key="ActiveBackgroundBrush"                Color="#3A2410"/>
            <SolidColorBrush x:Key="SelectionBackgroundBrush"             Color="#3A2410"/>
            <SolidColorBrush x:Key="SelectionBorderBrush"                 Color="#C27A2C"/>

            <!-- Status: nie allein über Farbe ausgedrückt, immer zusätzlich über Wort oder Zeichen. -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6FBF8A"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#E0A94F"/>
            <SolidColorBrush x:Key="StatusErrorBrush"   Color="#E8736B"/>

            <!-- Seitenleiste: der aktive Punkt hebt sich über die Fläche ab, nicht über die Schrift allein. -->
            <SolidColorBrush x:Key="NavigationViewPaneBorderBrush" Color="#3A2A1F"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground"                    Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"         Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"             Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"            Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed"     Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled"            Color="#8C735C"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedDisabled"    Color="#8C735C"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForeground"                    Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver"         Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed"             Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected"            Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed"     Color="#BFA58A"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundDisabled"            Color="#8C735C"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedDisabled"    Color="#8C735C"/>
            <SolidColorBrush x:Key="NavigationViewItemBackground"                    Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"         Color="#2E231C"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"             Color="#1A1410"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"            Color="#3A2A1F"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#52443A"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"     Color="#1A1410"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"            Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedDisabled"    Color="#2E231C"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"      Color="#C27A2C"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver"       Color="#F3E9DC"/>
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed"           Color="#BFA58A"/>

            <!-- Kachel der Linie: Kopf farbig, Körper hell — nicht umgekehrt. -->
            <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="#C27A2C"/>
            <SolidColorBrush x:Key="CardHeaderForegroundBrush" Color="#1A1410"/>
            <SolidColorBrush x:Key="CardBodyBackgroundBrush"   Color="#241B16"/>
            <SolidColorBrush x:Key="CardBodyForegroundBrush"   Color="#F3E9DC"/>
            <FontFamily x:Key="ThemeFontFamily">Merriweather Sans</FontFamily>
            <FontFamily x:Key="ThemeMonoFontFamily">Source Code Pro</FontFamily>
            <!-- ContentControlThemeFontFamily überschreibt den WinUI-3-Standard,
                 damit alle built-in Styles (BodyTextBlock, Caption usw.) die Theme-Schrift verwenden -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Merriweather Sans</FontFamily>

        </ResourceDictionary>

